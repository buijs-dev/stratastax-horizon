---
// The page frame of stratastax.dev: the theme of stratastax-design (src/styles/design/tokens.css, copied by
// npm run sync; global.css falls back to its own values), the header and the footer.
import '../styles/global.css';
import { site } from '../site.mjs';

import.meta.glob('../styles/design/tokens.css', { eager: true });

interface Props {
    title: string;
    description: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
        <script is:inline>
            // The dark tokens apply under data-theme="dark"; follow the system setting.
            const dark = matchMedia('(prefers-color-scheme: dark)');
            const apply = () => document.documentElement.setAttribute('data-theme', dark.matches ? 'dark' : 'light');
            apply();
            dark.addEventListener('change', apply);
        </script>
    </head>
    <body>
        <header class="site-header">
            <a class="site-title" href="/">Stratastax</a>
            <nav aria-label="Main">
                <a href={site.docsUrl}>Docs</a>
                {site.appLive ? <a href={site.appUrl}>App</a> : <span class="soon" title="Coming soon">App</span>}
                <a href={site.githubUrl}>GitHub</a>
            </nav>
        </header>
        <main>
            <slot />
        </main>
        <footer class="site-footer">
            <a href={site.docsUrl}>Documentation</a>
            <a href={`${site.docsUrl}/technical/api/`}>API</a>
            <a href={site.githubUrl}>GitHub</a>
            <span>© Buijs Software</span>
        </footer>
    </body>
</html>

<style>
    .site-header {
        position: relative;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        max-width: 72rem;
        margin: 0 auto;
        padding: 1rem;
    }
    .site-title {
        font-family: var(--font-display);
        font-weight: 800;
        font-size: 1.25rem;
        color: var(--color-primary);
        text-decoration: none;
    }
    nav {
        display: flex;
        gap: 1.25rem;
        font-weight: 600;
        font-size: 0.9375rem;
    }
    nav a,
    .site-footer a {
        color: var(--color-text);
        text-decoration: none;
    }
    nav a:hover,
    .site-footer a:hover {
        color: var(--color-primary);
    }
    .soon {
        color: var(--color-muted);
        cursor: default;
    }
    .soon::after {
        content: 'soon';
        margin-inline-start: 0.35rem;
        padding: 0.05rem 0.4rem;
        border-radius: var(--radius-pill);
        background: var(--color-surface-high);
        font-size: 0.6875rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }
    .site-footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 1.5rem;
        padding: 2rem 1rem 3rem;
        border-top: 1px solid var(--color-border);
        font-size: 0.875rem;
        color: var(--color-muted);
    }
</style>
